#!/usr/bin/env python3
"""Entry point: system/run <data_folder> <output_file> [--no-llm]

Kept to a few lines so the package imports the same way whether this file is run from the
repository root or from inside system/.
"""

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.dirname(HERE))

from system.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
